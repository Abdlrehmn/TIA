{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TIA",
  "version": "0.1.0",
  "identifier": "com.tia.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TIA — Personal AI Desktop Agent",
        "width": 1024,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
